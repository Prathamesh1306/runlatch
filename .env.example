# ==============================================================================
# RunLatch Configuration (.env.example)
# Copy to `.env` and customize for local CLI (Layer 1) or Production Server (Layer 2)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Default LLM Provider (Zero-Cost Local Ollama by default)
# ------------------------------------------------------------------------------
# Options: ollama | groq | github-models | openai | mock
RUNLATCH_LLM_PROVIDER=ollama
RUNLATCH_LLM_MODEL=qwen2.5-coder:7b
RUNLATCH_LLM_BASE_URL=http://localhost:11434/v1
RUNLATCH_LLM_API_KEY=ollama

# ------------------------------------------------------------------------------
# 2. Cloud LLM & GitHub Credentials (Optional — Bring Your Own Key)
# ------------------------------------------------------------------------------
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Groq Free Tier: https://console.groq.com/keys
GROQ_API_KEY=
# GitHub Personal Access Token (used for GitHubToolkit, PR comments, and GitHub Models free tier)
GITHUB_TOKEN=
# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. Storage & Distributed Queue Backbone (Slice 5–6 Server & Celery Workers)
# ------------------------------------------------------------------------------
# Layer 1 local default: sqlite+aiosqlite:///./.runlatch.db
# Layer 2 production:    postgresql+asyncpg://runlatch:runlatch_pass@localhost:5432/runlatch_db
RUNLATCH_DATABASE_URL=sqlite+aiosqlite:///./.runlatch.db
# Redis broker, webhook idempotency store, and SSE Pub/Sub backbone
RUNLATCH_REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Control Plane Security & Signed HITL Approval Links
# ------------------------------------------------------------------------------
# Bearer token for REST API authentication (`Authorization: Bearer <key>`)
RUNLATCH_API_KEY=dev-runlatch-api-key
# GitHub Webhook secret configured in your GitHub repository -> Settings -> Webhooks
RUNLATCH_GITHUB_WEBHOOK_SECRET=dev-github-webhook-secret
# 32+ byte secret used to HMAC-sign read-only `/ui/approvals/{id}?sig=...&exp=...` links
RUNLATCH_APPROVAL_SIGNING_SECRET=dev-approval-signing-secret-32bytes
# Publicly reachable base URL of the FastAPI server (embedded in Slack/Discord/Email links)
RUNLATCH_PUBLIC_BASE_URL=http://localhost:8000
# Minutes before a pending HITL approval request automatically expires
RUNLATCH_APPROVAL_TTL_MINUTES=60

# ------------------------------------------------------------------------------
# 5. Notification Channels (Slack, Discord & SMTP Email)
# ------------------------------------------------------------------------------
# Default Slack incoming webhook URL (resolved when notify_channels uses `slack:default`)
RUNLATCH_SLACK_WEBHOOK_URL=
# Default Discord webhook URL (resolved when notify_channels uses `discord:default`)
RUNLATCH_DISCORD_WEBHOOK_URL=
# Comma-separated default notification targets attached automatically to GitHub webhook runs
# Example: slack:default,email:dev@company.com
RUNLATCH_DEFAULT_NOTIFY_CHANNELS=
# SMTP settings for `SMTPEmailNotificationProvider` (`email:user@example.com`)
RUNLATCH_SMTP_HOST=localhost
RUNLATCH_SMTP_PORT=587
RUNLATCH_SMTP_USERNAME=
RUNLATCH_SMTP_PASSWORD=
RUNLATCH_SMTP_FROM=noreply@runlatch.dev
RUNLATCH_SMTP_USE_TLS=true

# ------------------------------------------------------------------------------
# 6. Budget & Policy Defaults
# ------------------------------------------------------------------------------
RUNLATCH_MAX_STEPS=15
RUNLATCH_MAX_TOKENS=80000
RUNLATCH_MAX_COST_USD=0.50
# READ | WRITE | EXEC | EXTERNAL
RUNLATCH_AUTO_APPROVE_MAX_TIER=WRITE
